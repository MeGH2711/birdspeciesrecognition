ning loop with validation and early stopping**\n","*   Loops through epochs to train and validate.\n","*   Unfreezes ViT backbone after certain epochs.\n","*   Saves best checkpoint and stops early if validation loss doesn’t improve."],"metadata":{"id":"hwjQQLwcQD2y"}},{"cell_type":"code","source":["train_losses, val_losses = [], []\n","train_accuracies, val_accuracies = [], []\n","start_epoch = 0\n","best_val_loss = np.inf\n","patience, patience_counter = 6, 0\n","\n","if os.path.exists(ckpt_path):\n","    start_epoch = load_checkpoint(model, optimizer, ckpt_path)\n","\n","if os.path.exists(train_loss_path) and os.path.exists(val_loss_path) and os.path.exists(train_acc_path) and os.path.exists(val_acc_path):\n","    train_losses = np.load(train_loss_path).tolist()\n","    val_losses = np.load(val_loss_path).tolist()\n","    print(f\"📈 Loaded previous training history ({len(train_losses)} epochs)\")\n","\n","    train_accuracies = np.load(train_acc_path).tolist()\n","    val_accuracies = np.load(val_acc_path).tolist()\n","    print(f\"📈 Loaded previous training & validation accuracy history ({len(train_losses)} epochs)\")\n","\n","    best_val_loss = min(val_losses)\n","    print(f\"✅ Previous best validation loss: {best_val_loss:.4f}\")\n","else:\n","    train_losses, val_losses = [], []\n","    best_val_loss = np.inf\n","\n","epochs = 7\n","for epoch in range(start_epoch, epochs):\n","    model.train()\n","    running_loss, correct, total = 0.0, 0, 0\n","\n","    if (epoch + 1) == unfreeze_at_epoch and not fine_tune_full:\n","        print(f\"🔓 Unfreezing model at epoch {epoch+1}\")\n","        fine_tune_full = True\n","        for param in model.parameters():\n","            param.requires_grad = True\n","        optimizer = torch.optim.AdamW(model.parameters(), lr=full_lr, weight_decay=weight_decay)\n","        scheduler = CosineAnnealingLR(optimizer, T_max=max(1, epochs - epoch), eta_min=1e-6)\n","\n","    pbar = tqdm(train_loader, desc=f\"Epoch {epoch+1}/{epochs}\")\n","    for imgs, labels in pbar:\n","        imgs, labels = imgs.to(device), labels.to(device)\n","        optimizer.zero_grad()\n","        with torch.cuda.amp.autocast():\n","            outputs = model(imgs)\n","            loss = criterion(outputs, labels)\n","        scaler.scale(loss).backward()\n","        scaler.unscale_(optimizer)\n","        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n","        scaler.step(optimizer)\n","        scaler.update()\n","        running_loss += loss.item() * imgs.size(0)\n","\n","        _, preds = torch.max(outputs, 1)\n","        correct += (preds == labels).sum().item()\n","        total += labels.size(0)\n","\n","    avg_train_loss = running_loss / len(train_loader.dataset)\n","    train_acc = correct / total\n","    train_losses.append(avg_train_loss)\n","    train_accuracies.append(train_acc)\n","\n","    # Validation\n","    model.eval()\n","    val_running, val_correct, val_total = 0.0, 0, 0\n","    with torch.no_grad():\n","        for imgs, labels in val_loader:\n","            imgs, labels = imgs.to(device), labels.to(device)\n","            with torch.cuda.amp.autocast():\n","                outputs = model(imgs)\n","                loss = criterion(outputs, labels)\n","            val_running += loss.item() * imgs.size(0)\n","            _, preds = torch.max(outputs, 1)\n","            val_correct += (preds == labels).sum().item()\n","            val_total += labels.size(0)\n","\n","    avg_val_loss = val_running / val_total\n","    val_acc = val_correct / val_total\n","    val_losses.append(avg_val_loss)\n","    val_accuracies.append(val_acc)\n","\n","    print(f\"Epoch [{epoch+1}/{epochs}] Train Loss: {avg_train_loss:.4f} | Val Loss: {avg_val_loss:.4f} | Val Acc: {val_acc*100:.2f}%\")\n","\n","    if avg_val_loss < best_val_loss:\n","        best_val_loss = avg_val_loss\n","        save_checkpoint(  epoch, model, optimizer, ckpt_path)\n","        patience_counter = 0\n","    else:\n","       