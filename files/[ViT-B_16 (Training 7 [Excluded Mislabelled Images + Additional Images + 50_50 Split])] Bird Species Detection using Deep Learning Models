ded_Images_Processing/modifiedImages.txt\", sep=\" \", names=[\"img_id\", \"path\"])\n","add_labels_df = pd.read_csv(f\"{root}/files/Manually_Added_Images_Processing/modifiedClassLabels.txt\", sep=\" \", names=[\"img_id\", \"label\"])\n","add_split_df  = pd.read_csv(f\"{root}/files/Manually_Added_Images_Processing/modifiedTrainTestSplit.txt\", sep=\" \", names=[\"img_id\", \"is_train\"])\n","\n","add_data_df = add_images_df.merge(add_labels_df, on=\"img_id\").merge(add_split_df, on=\"img_id\")\n","\n","train_df = pd.concat([train_df, add_data_df], ignore_index=False)\n","\n","train_df"]},{"cell_type":"markdown","metadata":{"id":"tc6hz9qHOdvE"},"source":["# **Data Transformations [Augmentation]**\n","Data augmentation improves generalization during training; normalization matches ViT’s pretrained ImageNet statistics.\n","\n","Augmentation Types:\n","\n","*   Random crop/resizing\n","*   Horizontal \u0026 vertical flips\n","*   Rotation\n","*   Color jitter (brightness, contrast, saturation, hue)\n","\n"]},{"cell_type":"code","execution_count":7,"metadata":{"executionInfo":{"elapsed":16,"status":"ok","timestamp":1763349820449,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"},"user_tz":-330},"id":"kF1v0ZSfOTr6"},"outputs":[],"source":["train_transforms = transforms.Compose([\n","    transforms.ToPILImage(),\n","    transforms.Resize(256),\n","    transforms.RandomResizedCrop(224, scale=(0.8, 1.0)),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.RandomVerticalFlip(p=0.1),\n","    transforms.RandomRotation(20),\n","    transforms.ColorJitter(brightness=0.25, contrast=0.25, saturation=0.25, hue=0.02),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n","])\n","\n","test_transforms = transforms.Compose([\n","    transforms.ToPILImage(),\n","    transforms.Resize(256),\n","    transforms.CenterCrop(224),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n","])"]},{"cell_type":"markdown","metadata":{"id":"9CqSZOSWOzR3"},"source":["# **Dataset class**\n","This class handles image reading, transformation, and label conversion for PyTorch training."]},{"cell_type":"code","execution_count":8,"metadata":{"executionInfo":{"elapsed":13,"status":"ok","timestamp":1763349820463,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"},"user_tz":-330},"id":"W5J2IbeeOhD9"},"outputs":[],"source":["class BirdDataset(Dataset):\n","    def __init__(self, dataframe, root, transforms=None):\n","        self.df = dataframe\n","        self.root = os.path.join(root, \"images\")\n","        self.manual_root = os.path.join(root, \"manually_selected_images\")\n","        self.transforms = transforms\n","\n","    def __getitem__(self, idx):\n","        row = self.df.iloc[idx]\n","        img_path = os.path.join(self.root, row[\"path\"])\n","\n","        # Try reading from main folder\n","        img = cv2.imread(img_path)\n","        if img is None:\n","            # Try manually added folder\n","            alt_path = os.path.join(self.manual_root, row[\"path\"])\n","            img = cv2.imread(alt_path)\n","\n","            if img is None:\n","                print(f\"⚠️ Warning: Failed to read image at {img_path} or {alt_path}\")\n","                img = np.zeros((224, 224, 3), dtype=np.uint8)\n","            else:\n","                img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n","        else:\n","            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n","\n","        if self.transforms:\n","            img = self.transforms(img)\n","\n","        label = torch.tensor(row[\"label\"] - 1, dtype=torch.long)\n","        return img, label\n","\n","    def __len__(self):\n","        return len(self.df)"]},{"cell_type":"markdown","metadata":{"id":"E2-KR1-2PZFL"},"source":["# **Split data into train/val/test loaders**\n","Splits data for training, validation, and testing; creates dataloaders for batch processing and GPU acceleration."]},{"cell_type":"code","execution_count":9,"metadata":{"executionInfo":{"elapsed":248,"status":"ok","timestamp":1763349820718,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"},"user_tz":-330},"id":"tDlTBAgVPaLP"},"outputs":[],"source":["val_fraction = 0.1\n","batch_size = 32\n","\n","full_train_dataset = BirdDataset(train_df, root, transforms=train_transforms)\n","num_train = len(full_train_dataset)\n","val_size = int(val_fraction * num_train)\n","train_size = num_train - val_size\n","\n","train_dataset, val_dataset = random_split(full_train_dataset, [train_size, val_size])\n","test_dataset = BirdDataset(test_df, root, transforms=test_transforms)\n","\n","device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","num_workers = 4 if torch.cuda.is_available() else 0\n","pin_memory = torch.cuda.is_available()\n","\n","train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True, num_workers=num_workers, pin_memory=pin_memory)\n","val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False, num_workers=num_workers, pin_memory=pin_memory)\n","test_loader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False, num_workers=num_workers, pin_memory=pin_memory)"]},{"cell_type":"markdown","metadata":{"id":"6X7d1kW9Pk83"},"source":["# **Model Setup**\n","\n","*   Uses ViT-B/16 model from `timm`.\n","*   Starts by training only the classification head; backbone unfrozen later for fine-tuning.\n","*   Uses mixed precision training for speed and efficiency."]},{"cell_type":"code","execution_count":10,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":2941,"status":"ok","timestamp":1763349823662,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"},"user_tz":-330},"id":"-xJi6tknPdIk","outputId":"50c00f25-bc7c-4523-96c0-4345c7ddaa33"},"outputs":[{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/huggingface_hub/utils/_auth.py:94: UserWarning: \n","The secret `HF_TOKEN` does not exist in your Colab secrets.\n","To authenticate with the Hugging Face Hub, create a token in your settings tab (https://huggingface.co/settings/tokens), set it as secret in your Google Colab and restart your session.\n","You will be able to reuse this secret in all of your notebooks.\n","Please note that authentication is recommended but still optional to access public models or datasets.\n","  warnings.warn(\n","/tmp/ipython-input-983281692.py:23: FutureWarning: `torch.cuda.amp.GradScaler(args...)` is deprecated. Please use `torch.amp.GradScaler('cuda', args...)` instead.\n","  scaler = torch.cuda.amp.GradScaler()\n","/usr/local/lib/python3.12/dist-packages/torch/amp/grad_scaler.py:136: UserWarning: torch.cuda.amp.GradScaler is enabled, but CUDA is not available.  Disabling.\n","  warnings.warn(\n"]}],"source":["num_classes = len(train_df[\"label\"].unique())\n","model = timm.create_model('vit_base_patch16_224', pretrained=True, num_classes=num_classes)\n","model = model.to(device)\n","\n","criterion = nn.CrossEntropyLoss()\n","\n","fine_tune_full = False\n","unfreeze_at_epoch = 5\n","head_lr = 3e-4\n","full_lr = 1e-5\n","weight_decay = 0.01\n","\n","# freeze backbone initially\n","if not fine_tune_full:\n","    for param in model.parameters():\n","        param.requires_grad = False\n","    if hasattr(model, 'head'):\n","        for p in model.head.parameters():\n","            p.requires_grad = True\n","\n","optimizer = torch.optim.AdamW(filter(lambda p: p.requires_grad, model.parameters()), lr=head_lr, weight_decay=weight_decay)\n","scheduler = CosineAnnealingLR(optimizer, T_max=10, eta_min=1e-6)\n","scaler = torch.cuda.amp.GradScaler()"]},{"cell_type":"markdown","metadata":{"id":"k-7ytnZ_P4YH"},"source":["# **Checkpoint helpers**\n","Allows resuming training or loading the best model for evaluation later."]},{"cell_type":"code","execution_count":11,"metadata":{"executionInfo":{"elapsed":23,"status":"ok","timestamp":1763349823687,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"},"user_tz":-330},"id":"Gdq7nLSFPz9e"},"outputs":[],"source":["def save_checkpoint(epoch, model, optimizer, filename=ckpt_path):\n","    torch.save({'epoch': epoch, 'model_state_dict': model.state_dict(), 'optimizer_state_dict': optimizer.state_dict()}, filename)\n","    print(f\"💾 Checkpoint saved at epoch {epoch+1}\")\n","\n","def load_checkpoint(model, optimizer, filename=ckpt_path):\n","    checkpoint = torch.load(filename, map_location=device)\n","    model.load_state_dict(checkpoint['model_state_dict'])\n","    print(f\"🔄 Resumed from epoch {checkpoint['epoch']+1}\")\n","    return checkpoint['epoch'] + 1"]},{"cell_type":"markdown","metadata":{"id":"hwjQQLwcQD2y"},"source":["# **Training loop with validation and early stopping**\n","*   Loops through epochs to train and validate.\n","*   Unfreezes ViT backbone after certain epochs.\n","*   Saves best checkpoint and stops early if validation loss doesn’t improve."]},{"cell_type":"code","execution_count":12,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":2138,"status":"ok","timestamp":1763349825837,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"},"user_tz":-330},"id":"Q9LMCJG6P8_l","outputId":"82c2612d-8486-4e7c-f43a-9bb94c814e7f"},"outputs":[{"name":"stdout","output_type":"stream","text":["🔄 Resumed from epoch 8\n","📈 Loaded previous training history (13 epochs)\n","📈 Loaded previous training \u0026 validation accuracy history (13 epochs)\n","✅ Previous best validation loss: 0.6766\n","🎉 Training completed. Best val loss: 0.6765714086993726\n"]}],"source":["train_losses, val_losses = [], []\n","train_accuracies, val_accuracies = [], []\n","start_epoch = 0\n","best_val_loss = np.inf\n","patience, patience_counter = 6, 0\n","epochs = 8\n","\n","if os.path.exists(ckpt_path):\n","    start_epoch = load_checkpoint(model, optimizer, ckpt_path)\n","\n","if os.path.exists(train_loss_path) and os.path.exists(val_loss_path) and os.path.exists(train_acc_path) and os.path.exists(val_acc_path):\n","    train_losses = np.load(train_loss_path).tolist()\n","    val_losses = np.load(val_loss_path).tolist()\n","    print(f\"📈 Loaded previous training history ({len(train_losses)} epochs)\")\n","\n","    train_accuracies = np.load(train_acc_path).tolist()\n","    val_accuracies = np.load(val_acc_path).tolist()\n","    print(f\"📈 Loaded previous training \u0026 validation accuracy history ({len(train_losses)} epochs)\")\n","\n","    best_val_loss = min(val_losses)\n","    print(f\"✅ Previous best validation loss: {best_val_loss:.4f}\")\n","else:\n","    train_losses, val_losses = [], []\n","    best_val_loss = np.inf\n","\n","for epoch in range(start_epoch, epochs):\n","    model.train()\n","    running_loss, correct, total = 0.0, 0, 0\n","\n","    if (epoch + 1) == unfreeze_at_epoch and not fine_tune_full:\n","        print(f\"🔓 Unfreezing model at epoch {epoch+1}\")\n","        fine_tune_full = True\n","        for param in model.parameters():\n","            param.requires_grad = True\n","        optimizer = torch.optim.AdamW(model.parameters(), lr=full_lr, weight_decay=weight_decay)\n","        scheduler = CosineAnnealingLR(optimizer, T_max=max(1, epochs - epoch), eta_min=1e-6)\n","\n","    pbar = tqdm(train_loader, desc=f\"Epoch {epoch+1}/{epochs}\")\n","    for imgs, labels in pbar:\n","        imgs, labels = imgs.to(device), labels.to(device)\n","        optimizer.zero_grad()\n","        with torch.cuda.amp.autocast():\n","            outputs = model(imgs)\n","            loss = criterion(outputs, labels)\n","        scaler.scale(loss).backward()\n","        scaler.unscale_(optimizer)\n","        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n","        scaler.step(optimizer)\n","        scaler.update()\n","        running_loss += loss.item() * imgs.size(0)\n","\n","        _, preds = torch.max(outputs, 1)\n","        correct += (preds == labels).sum().item()\n","        total += labels.size(0)\n","\n","    avg_train_loss = running_loss / len(train_loader.dataset)\n","    train_acc = correct / total\n","    train_losses.append(avg_train_loss)\n","    train_accuracies.append(train_acc)\n","\n","    # Validation\n","    model.eval()\n","    val_running, val_correct, val_total = 0.0, 0, 0\n","    with torch.no_grad():\n","        for imgs, labels in val_loader:\n","            imgs, labels = imgs.to(device), labels.to(device)\n","            with torch.cuda.amp.autocast():\n","                outputs = model(imgs)\n","                loss = criterion(outputs, labels)\n","            val_running += loss.item() * imgs.size(0)\n","            _, preds = torch.max(outputs, 1)\n","            val_correct += (preds == labels).sum().item()\n","            val_total += labels.size(0)\n","\n","    avg_val_loss = val_running / val_total\n","    val_acc = val_correct / val_total\n","    val_losses.append(avg_val_loss)\n","    val_accuracies.append(val_acc)\n","\n","    print(f\"Epoch [{epoch+1}/{epochs}] Train Loss: {avg_train_loss:.4f} | Val Loss: {avg_val_loss:.4f} | Val Acc: {val_acc*100:.2f}%\")\n","\n","    if avg_val_loss \u003c best_val_loss:\n","        best_val_loss = avg_val_loss\n","        save_checkpoint(  epoch, model, optimizer, ckpt_path)\n","        patience_counter = 0\n","    else:\n","        patience_counter += 1\n","        if patience_counter \u003e= patience:\n","            print(\"⛔ Early stopping triggered.\")\n","            break\n","\n","    scheduler.step()\n","\n","    np.save(train_loss_path, np.array(train_losses))\n","    np.save(val_loss_path, np.array(val_losses))\n","    np.save(train_acc_path, np.array(train_accuracies))\n","    np.save(val_acc_path, np.array(val_accuracies))\n","\n","print(\"🎉 Training completed. Best val loss:\", best_val_loss)"]},{"cell_type":"markdown","metadata":{"id":"9ktDnDw9Q8vF"},"source":["# **Evaluation on test set**\n","\n","1.   **Load Best Model:** Reloads the checkpoint that achieved the lowest validation loss.\n","\n","2.   **Switch to Evaluation Mode:** `model.eval()` disables dropout and batch norm updates for stable inference.\n","\n","3.   **Iterate Over Test Loader:**\n","\n","        * Runs model on each batch of test images.\n","        * Uses mixed-precision inference for speed.\n","        * Collects predictions and true labels."]},{"cell_type":"code","execution_count":13,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":814,"status":"ok","timestamp":1763349826669,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"},"user_tz":-330},"id":"bjeqXs70Q9mA","outputId":"eac66d96-b76b-4de5-f06c-844acd4cf019"},"outputs":[{"name":"stdout","output_type":"stream","text":["✅ Loaded cached test predictions, labels, and losses from Drive.\n","📊 Average Test Loss: 0.5247\n"]}],"source":["if os.path.exists(preds_path) and os.path.exists(labels_path) and os.path.exists(test_loss_path):\n","    all_preds = np.load(preds_path)\n","    all_labels = np.load(labels_path)\n","    test_losses = np.load(test_loss_path)\n","    avg_test_loss = np.mean(test_losses)\n","    print(\"✅ Loaded cached test predictions, labels, and losses from Drive.\")\n","    print(f\"📊 Average Test Loss: {avg_test_loss:.4f}\")\n","else:\n","    print(\"🧠 Running model evaluation...\")\n","    model.eval()\n","    all_preds, all_labels = [], []\n","    test_losses = []\n","\n","    with torch.no_grad():\n","        for imgs, labels in tqdm(test_loader, desc=\"Testing\"):\n","            imgs, labels = imgs.to(device), labels.to(device)\n","            with torch.cuda.amp.autocast():\n","                outputs = model(imgs)\n","                loss = criterion(outputs, labels)\n","                _, preds = torch.max(outputs, 1)\n","            test_losses.append(loss.item())\n","            all_preds.extend(preds.cpu().numpy())\n","      