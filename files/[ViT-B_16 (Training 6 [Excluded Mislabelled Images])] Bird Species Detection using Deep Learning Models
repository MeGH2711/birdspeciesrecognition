z":-330,"elapsed":11,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"}},"outputId":"51f287f2-e3c4-4e96-f4d7-97588aa5d3a6"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["if os.path.exists(classes_txt):\n","    with open(classes_txt, \"r\") as f:\n","        class_names = [line.strip().split(\" \", 1)[1] for line in f.readlines()]\n","else:\n","    class_names = [f\"Species_{i+1}\" for i in range(num_classes)]\n","\n","def extract_family_token(species_name):\n","    clean = species_name.replace(\"_\", \" \").replace(\"-\", \" \").strip()\n","    words = clean.split()\n","    return words[-1].lower() if words else \"unknown\"\n","\n","family_tokens = {i: extract_family_token(name) for i, name in enumerate(class_names)}\n","\n","same_family, diff_family = 0, 0\n","for i in misclassified_indices:\n","    true_label = all_labels[i]\n","    pred_label = all_preds[i]\n","    fam_true = family_tokens.get(true_label, \"unknown\")\n","    fam_pred = family_tokens.get(pred_label, \"unknown\")\n","    if fam_true == fam_pred:\n","        same_family += 1\n","    else:\n","        diff_family += 1\n","\n","sizes = [same_family, diff_family]\n","labels = ['Same Family (Heuristic)', 'Different Family']\n","colors = ['#B32024', '#FF9800']\n","\n","fig, ax_pie = plt.subplots(figsize=(6, 6), facecolor='white')\n","\n","wedges, _ = ax_pie.pie(\n","    sizes,\n","    startangle=90,\n","    colors=colors,\n","    explode=(0.03, 0.03),\n","    radius=1.0\n",")\n","\n","total = sum(sizes)\n","for i, w in enumerate(wedges):\n","    ang = (w.theta2 + w.theta1) / 2\n","    x = np.cos(np.deg2rad(ang))\n","    y = np.sin(np.deg2rad(ang))\n","\n","    line_start = (x * 0.9, y * 0.9)\n","    line_end = (x * 1.2, y * 1.2)\n","\n","    ax_pie.plot([line_start[0], line_end[0]], [line_start[1], line_end[1]],\n","                color='#801214', lw=1.8, alpha=0.9)\n","\n","    ha = 'lef