,"        transforms.RandomRotation(20),\n","        transforms.ColorJitter(brightness=0.25, contrast=0.25, saturation=0.25, hue=0.02)\n","    ])(x)\n","}\n","\n","augmented_images = [(name, func(img_pil)) for name, func in augmentations.items()]\n","\n","fig, axes = plt.subplots(2, 4, figsize=(14, 7))\n","axes = axes.flatten()\n","\n","for ax, (title, image) in zip(axes, augmented_images):\n","    ax.imshow(image)\n","    ax.set_title(title, fontsize=10)\n","    ax.axis(\"off\")\n","\n","for ax in axes[len(augmented_images):]:\n","    ax.axis(\"off\")\n","\n","plt.suptitle(\"Data Augmentation Effects — ViT-B/16\", fontsize=16)\n","plt.tight_layout()\n","plt.show()\n","\n","save_path = f\"{root}/files/ViT-B16/ViT-B16-Training3/augmentations_labeled.jpg\"\n","fig.savefig(save_path, bbox_inches='tight')\n","print(f\"✅ Saved labeled augmentation visualization to: {save_path}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":860},"id":"fCahBW1jgAOG","executionInfo":{"status":"ok","timestamp":1763349674275,"user_tz":-330,"elapsed":695,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"}},"outputId":"0466f6bd-2af8-49b4-aae6-e8e37819135a"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x900 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.metrics import confusion_matrix\n","from matplotlib.colors import LinearSegmentedColormap\n","\n","cm = confusion_matrix(all_labels, all_preds)\n","\n","# Clean bright colormap similar to Blues but using #801214\n","custom_cmap = LinearSegmentedColormap.from_list(\n","    \"maroon_shades\",\n","    [\n","        \"#ffffff\",   # white (0)\n","        \"#f5d7dd\",   # very light maroon tint\n","        \"#d48c98\",   # mid-light maroon\n","        \"#b34a5a\",   # medium maroon\n","        \"#801214\"    # dark maroon (max)\n","    ]\n",")\n","\n","plt.figure(figsize=(16, 9))\n","\n","sns.heatmap(\n","    cm,\n","    cmap=custom_cmap,\n","    square=False,\n","    xticklabels=False,  # we'll set custom ticks\n","    yticklabels=False,\n","    cbar=True\n",")\n","\n","# Title + Label\n","plt.title('Confusion Matrix - ViT-B/16 Fine-tuned', color=\"#801214\")\n","plt.xlabel('Predicted', fontsize=14, color=\"#801214\")\n","plt.ylabel('True', fontsize=14, color=\"#801214\")\n","\n","# Tick marks every 5 steps\n","plt.xticks(\n","    ticks=range(0, cm.shape[1], 5),\n","    labels=range(0, cm.shape[1], 5),\n","    color=\"#801214\"\n",")\n","\n","plt.yticks(\n","    ticks=range(0, cm.shape[0], 5),\n","    labels=range(0, cm.shape[0], 5),\n","    color=\"#801214\"\n",")\n","\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","source":["full_cm = cm\n","\n","# --- Smarter Plot Function ---\n","def plot_cm(matrix, title, xlab=\"Predicted\", ylab=\"True\"):\n","    matrix = np.asarray(matrix).astype(int)   # <-- IMPORTANT FIX\n","\n","    plt.figure(figsize=(10, 8))\n","\n","    annotate = matrix.shape[0] <= 20 and matrix.shape[1] <= 20\n","\n","    sns.heatmap(\n","        matrix,\n","        annot=annotate,\n","        fmt=\"d\" if annotate else \"\",\n","        cmap=\"Blues\"\n","    )\n","\n","    plt.title(title)\n","    plt.xlabel(xlab)\n","    plt.ylabel(ylab)\n","    plt.tight_layout()\n","    return plt.gcf()\n","\n","def get_misclassified_images(selected_species):\n","    if selected_species == \"All Classes\":\n","        return []\n","\n","    class_idx = class_names.index(selected_species)\n","    mis_imgs = []\n","\n","    for i in range(len(all_preds)):\n","        if all_labels[i] == class_idx and all_preds[i] != class_idx:\n","\n","            row = test_df.iloc[i]\n","            img_path = os.path.join(root, \"images\", row[\"path\"])\n","\n","            if not os.path.exists(img_path):\n","                continue\n","\n","            img = cv2.imread(img_path)\n","            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n","\n","            pred_name = class_names[all_preds[i]].replace(\"_\", \" \")\n","\n","            caption = f\"Predicted: {pred_name}\"\n","            mis_imgs.append((img, caption))\n","\n","    return mis_imgs\n","\n","def get_confusion_matrix(selected_species):\n","\n","    # If user selected ALL classes → no metrics\n","    if selected_species == \"All Classes\":\n","        fig = plot_cm(full_cm, \"Complete Confusion Matrix (All Classes)\")\n","        return fig, \"\", \"\", []\n","\n","    class_idx = class_names.index(selected_species)\n","\n","    # One-vs-Rest labels\n","    y_true = (np.array(all_labels) == class_idx).astype(int)\n","    y_pred = (np.array(all_preds) == class_idx).astype(int)\n","\n","    cm_bin = confusion_matrix(y_true, y_pred)\n","\n","    # Ensure 2×2\n","    if cm_bin.shape != (2, 2):\n","        fixed = np.zeros((2, 2), dtype=int)\n","        for i in range(cm_bin.shape[0]):\n","            for j in range(cm_bin.shape[1]):\n","                fixed[i, j] = cm_bin[i, j]\n","        cm_bin = fixed\n","\n","    TP = cm_bin[1, 1]\n","    FN = cm_bin[1, 0]\n","    FP = cm_bin[0, 1]\n","    TN = cm_bin[0, 0]\n","\n","    # Calculate metrics\n","    precision = TP / (TP + FP + 1e-10)\n","    recall = TP / (TP + FN + 1e-10)\n","    f1 = 2 * (precision * recall) / (precision + recall + 1e-10)\n","    support = TP + FN\n","\n","    # ---------- TABLE FORMAT ----------\n","    cm_table = f\"\"\"\n","### Confusion Matrix (Binary)\n","| Metric | Value |\n","|--------|-------|\n","| **TP** | {TP} |\n","| **FP** | {FP} |\n","| **FN** | {FN} |\n","| **TN** | {TN} |\n","\"\"\"\n","\n","    metrics_table = f\"\"\"\n","### Classification Metrics\n","| Metric | Value |\n","|--------|--------|\n","| **Precision** | {precision:.4f} |\n","| **Recall** | {recall:.4f} |\n","| **F1-Score** | {f1:.4f} |\n","| **Support** | {support} |\n","\"\"\"\n","\n","    fig = plot_cm(cm_bin, f\"2×2 Confusion Matrix for Class: {selected_species}\")\n","\n","    mis_imgs = get_misclassified_images(selected_species)\n","\n","    return fig, cm_table, metrics_table, mis_imgs\n","\n","\n","dropdown_classes = [\"All Classes\"] + class_names\n","\n","# ============================\n","# UI WITH AUTO-LOAD DEFAULT\n","# ============================\n","\n","custom_css = \"\"\"\n","#confusion_plot_container {\n","    height: 75vh !important;\n","    max-height: 75vh !important;\n","}\n","#confusion_plot_container > div {\n","    height: 100% !important;\n","}\n","#confusion_plot_container canvas,\n","#confusion_plot_container img {\n","    height: 100% !important;\n","    width: auto !important;\n","    object-fit: contain !important;\n","}\n","#mis_gallery img {\n","    height: 80px !important;   /* Adjust height as needed */\n","    width: auto !important;\n","    object-fit: contain !important;\n","}\n","\"\"\"\n","\n","with gr.Blocks(css=custom_css) as cm_ui:\n","\n","    gr.Markdown(\"## 🔎 Bird Species Confusion Matrix Explorer\")\n","    gr.Markdown(\n","        \"Select a species to show its 2×2 confusion matrix, confusion table, \"\n","        \"and classification metrics. Select **All Classes** to view the full matrix.\"\n","    )\n","\n","    with gr.Row():\n","\n","        # LEFT PANEL\n","        with gr.Column(scale=2):\n","\n","          species_dropdown = gr.Dropdown(\n","              choices=dropdown_classes,\n","              label=\"Select Bird Species\",\n","              value=\"All Classes\"\n","          )\n","\n","          with gr.Row():   # ⬅️ NEW: side-by-side tables\n","              cm_values_box = gr.Markdown(\"\")   # Confusion Matrix Table\n","              metrics_box = gr.Markdown(\"\")     # Metrics Table\n","\n","        # RIGHT PANEL\n","        with gr.Column(scale=2):\n","            output_plot = gr.Plot(\n","                label=\"Confusion Matrix\",\n","                elem_id=\"confusion_plot_container\"\n","            )\n","\n","    with gr.Row():\n","            mis_gallery = gr.Gallery(\n","                label=\"Misclassified Images for Selected Class\",\n","                columns=4,\n","                rows=2,\n","                height=\"auto\",\n","                show_label=True\n","            )\n","\n","    # When dropdown changes\n","    species_dropdown.change(\n","        fn=get_confusion_matrix,\n","        inputs=species_dropdown,\n","        outputs=[output_plot, cm_values_box, metrics_box, mis_gallery]\n","    )\n","\n","    cm_ui.load(\n","        fn=get_confusion_matrix,\n","        inputs=species_dropdown,\n","        outputs=[output_plot, cm_values_box, metrics_box, mis_gallery]\n","    )\n","\n","cm_ui.launch(share=True, inline=False)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3kWTm4KD_Uki","executionInfo":{"status":"ok","timestamp":1763349675893,"user_tz":-330,"elapsed":1616,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"}},"outputId":"24572f96-2a91-4424-ba18-3826776e5e0a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Colab notebook detected. To show errors in colab notebook, set debug=True in launch()\n","* Running on public URL: https://3105fe29a8059e9754.gradio.live\n","\n","This share link expires in 1 week. For free permanent hosting and GPU upgrades, run `gradio deploy` from the terminal in the working directory to deploy to Hugging Face Spaces (https://huggingface.co/spaces)\n"]},{"output_type":"execute_result","data":{"text/plain":[]},"metadata":{},"execution_count":30}]}],"metadata":{"accelerator":"GPU","colab":{"gpuType":"T4","provenance":[]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"},"widgets":{"application/vnd.jupyter.widget-state+json":{"989ff3127ab74c6c853d7e519cb1a056":{"model_module":"@jupyter-widgets/controls","model_name":"HBoxModel","model_module_version":"1.5.0","state":{"_dom_classes":[],"_model_module":"@jupyter-widgets/controls","_model_modu