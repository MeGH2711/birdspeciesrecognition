dentify misclassified indices where family differs\n","misclassified_indices = [i for i in range(len(all_preds)) if all_preds[i] != all_labels[i]]\n","\n","# Extract family token function (same as used earlier)\n","def extract_family_token(species_name):\n","    clean = species_name.replace(\"_\", \" \").replace(\"-\", \" \").strip()\n","    words = clean.split()\n","    return words[-1].lower() if words else \"unknown\"\n","\n","family_tokens = {i: extract_family_token(name) for i, name in enumerate(class_names)}\n","\n","# Collect different-family misclassified samples\n","diff_family_samples = []\n","for i in misclassified_indices:\n","    true_label = all_labels[i]\n","    pred_label = all_preds[i]\n","    fam_true = family_tokens.get(true_label, \"unknown\")\n","    fam_pred = family_tokens.get(pred_label, \"unknown\")\n","    if fam_true != fam_pred:\n","        diff_family_samples.append(i)\n","\n","print(f\"Total misclassified samples from different families: {len(diff_family_samples)}\")\n","\n","# --- Plot all images in a grid ---\n","n_images = len(diff_family_samples)\n","cols = 6\n","rows = int(np.ceil(n_images / cols))\n","plt.figure(figsize=(22, rows * 3))\n","\n","for idx, mis_idx in enumerate(diff_family_samples):\n","    row = test_df.iloc[mis_idx]\n","    img_path = os.path.join(root, \"images\", row[\"path\"])\n","    if not os.path.exists(img_path):\n","        continue\n","\n","    img = cv2.imread(img_path)\n","    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n","\n","    true_label = all_labels[mis_idx]\n","    pred_label = all_preds[mis_idx]\n","    true_name = class_names[true_label].replace(\"_\", \" \")\n","    pred_name = class_names[pred_label].replace(\"_\", \" \")\n","\n","    plt.subplot(rows, cols, idx + 1)\n","    plt.imshow(img)\n","    plt.axis(\"off\")\n","    plt.title(\n","        f\"True: {true_name}\\nPred: {pred_name}\",\n","        fontsize=9,\n","        color=\"red\",\n","        pad=5\n","    )\n","\n","plt.suptitle(\"Mis