_samples)\n","\n","    plt.figure(figsize=(15, 10))\n","    for i, idx in enumerate(sample_indices):\n","        row = test_df.iloc[idx]\n","        img_path = os.path.join(root, \"images\", row[\"path\"])\n","        img = cv2.imread(img_path)\n","        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n","\n","        true_label = all_labels[idx]\n","        pred_label = all_preds[idx]\n","\n","        true_name = class_names[true_label]\n","        pred_name = class_names[pred_label]\n","\n","        plt.subplot(3, 4, i+1)\n","        plt.imshow(img)\n","        plt.axis(\"off\")\n","        plt.title(f\"True: {true_name}\\nPred: {pred_name}\", color=\"red\", fontsize=9)\n","\n","    plt.suptitle(\"Misclassified Samples — ViT-B/16 Model\", fontsize=14)\n","    plt.tight_layout()\n","    plt.show()"]},{"cell_type":"markdown","metadata":{"id":"gij3rXWf-M78"},"source":["# **Before and After Train-Test Comparision of Data Preprocessing**"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":640},"id":"Wxuegw6q9CYJ","executionInfo":{"status":"ok","timestamp":1763349613690,"user_tz":-330,"elapsed":9,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"}},"outputId":"3c60a22d-b3df-4af4-db55-c19b98f5517a"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# Dataset Sizes\n","train_size = len(train_dataset)\n","val_size = len(val_dataset)\n","test_size = len(test_dataset)\n","\n","train_df_size = len(orig_train_df)\n","test_df_size = len(orig_test_df)\n","\n","colors_before = ['#801214', '#B32024']\n","colors_after  = ['#801214', '#B32024', '#CC272C']\n","\n","# Pie chart data\n","sizes_before = [train_df_size, test_df_size]\n","labels_before = ['Train', 'Test']\n","\n","sizes_after = [train_size, val_size, test_size]\n","labels_after = ['Train', 'Validation', 'Test']\n","\n","def autopct_format(pct, all_vals):\