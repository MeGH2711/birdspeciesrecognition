 extract_family_token(species_name):\n","    clean = species_name.replace(\"_\", \" \").replace(\"-\", \" \").strip()\n","    words = clean.split()\n","    return words[-1].lower() if words else \"unknown\"\n","\n","family_tokens = {i: extract_family_token(name) for i, name in enumerate(class_names)}\n","\n","# --- Compare true vs predicted \"family\" tokens ---\n","same_family, diff_family = 0, 0\n","for i in misclassified_indices:\n","    true_label = all_labels[i]\n","    pred_label = all_preds[i]\n","    fam_true = family_tokens.get(true_label, \"unknown\")\n","    fam_pred = family_tokens.get(pred_label, \"unknown\")\n","    if fam_true == fam_pred:\n","        same_family += 1\n","    else:\n","        diff_family += 1\n","\n","# --- Data ---\n","sizes = [same_family, diff_family]\n","labels = ['Same Family (Heuristic)', 'Different Family']\n","colors = ['#B32024', '#FF9800']\n","\n","# --- Figure (just the pie chart) ---\n","fig, ax_pie = plt.subplots(figsize=(6, 6), facecolor='white')\n","\n","# --- Pie Chart ---\n","wedges, _ = ax_pie.pie(\n","    sizes,\n","    startangle=90,\n","    colors=colors,\n","    explode=(0.03, 0.03),\n","    radius=1.0\n",")\n","\n","# --- External labels with leader lines ---\n","total = sum(sizes)\n","for i, w in enumerate(wedges):\n","    ang = (w.theta2 + w.theta1) / 2\n","    x = np.cos(np.deg2rad(ang))\n","    y = np.sin(np.deg2rad(ang))\n","\n","    # Line endpoints\n","    line_start = (x * 0.9, y * 0.9)\n","    line_end = (x * 1.2, y * 1.2)\n","\n","    # Draw leader line\n","    ax_pie.plot([line_start[0], line_end[0]], [line_start[1], line_end[1]],\n","                color='#801214', lw=1.8, alpha=0.9)\n","\n","    # Add label\n","    ha = 'left' if x >= 0 else 'right'\n","    ax_pie.text(\n","        line_end[0] + (0.05 if x >= 0 else -0.05),\n","        line_end[1],\n","        f\"{labels[i]}\\n({sizes[i]} images, {sizes[i]/total*100:.1f}%)\",\n","        ha=ha, va='center',\n","        fontsize=11, fontweight='bol