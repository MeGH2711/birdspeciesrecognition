seaborn-v0_8-darkgrid')\n","fig, axes = plt.subplots(1, 2, figsize=(12, 6), facecolor='white')\n","\n","# Font & title style\n","title_font = {'fontsize': 14, 'fontweight': 'bold', 'color': '#4D0A0C'}\n","\n","# Left pie: Before preprocessing\n","wedges1, texts1, autotexts1 = axes[0].pie(\n","    sizes_before,\n","    labels=labels_before,\n","    autopct=lambda pct: autopct_format(pct, sizes_before),\n","    startangle=90,\n","    colors=colors_before,\n","    explode=(0.0125, 0.0125),\n","    textprops={'color': 'white', 'fontsize': 11, 'weight': 'bold'}\n",")\n","axes[0].set_title('Dataset Split — Train / Test\\n[Before Preprocessing]', **title_font)\n","\n","# Right pie: After preprocessing\n","wedges2, texts2, autotexts2 = axes[1].pie(\n","    sizes_after,\n","    labels=labels_after,\n","    autopct=lambda pct: autopct_format(pct, sizes_after),\n","    startangle=90,\n","    colors=colors_after,\n","    explode=(0.025, 0.025, 0.025),\n","    textprops={'color': 'white', 'fontsize': 11, 'weight': 'bold'}\n",")\n","axes[1].set_title('Dataset Split — Train / Validation / Test\\n[After Preprocessing (Manual Splitting)]', **title_font)\n","\n","# Consistent text appearance\n","for autotexts in [autotexts1, autotexts2]:\n","    for t in autotexts:\n","        t.set_color('white')\n","        t.set_fontsize(10)\n","        t.set_weight('bold')\n","\n","# Background & layout\n","for ax in axes:\n","    ax.set_facecolor('#F8F5F5')\n","    ax.set_aspect('equal')\n","\n","plt.suptitle('Dataset Distribution Overview', fontsize=16, color='#801214', weight='bold', y=1.03)\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":640},"id":"Wxuegw6q9CYJ","executionInfo":{"status":"ok","timestamp":1762418857405,"user_tz":-330,"elapsed":6,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"}},"outputId":"3d262e02-753e-45ed-f8cf-61b48693ec4b"},"execution_count":22,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# **Misclassification Family Distribution Pie Chart**"],"metadata":{"id":"ozyD1I6YBtSa"}},{"cell_type":"code","source":["if os.path.exists(classes_txt):\n","    with open(classes_txt, \"r\") as f:\n","        class_names = [line.strip().split(\" \", 1)[1] for line in f.readlines()]\n","else:\n","    class_names = [f\"Species_{i+1}\" for i in range(num_classes)]\n","\n","# --- Extract simple \"family-like\" tokens from species names ---\n","def extract_family_token(species_name):\n","    clean = species_name.replace(\"_\", \" \").replace(\"-\", \" \").strip()\n","    words = clean.split()\n","    return words[-1].lower() if words else \"unknown\"\n","\n","family_tokens = {i: extract_family_token(name) for i, name in enumerate(class_names)}\n","\n","# --- Compare true vs predicted \"family\" tokens ---\n","same_family, diff_family = 0, 0\n","for i in misclassified_indices:\n","    true_label = all_labels[i]\n","    pred_label = all_preds[i]\n","    fam_true = family_tokens.get(true_label, \"unknown\")\n","    fam_pred = family_tokens.get(pred_label, \"unknown\")\n","    if fam_true == fam_pred:\n","        same_family += 1\n","    else:\n","        diff_family += 1\n","\n","# --- Data ---\n","sizes = [same_family, diff_family]\n","labels = ['Same Family (Heuristic)', 'Different Family']\n","colors = ['#B32024', '#FF9800']\n","\n","# --- Figure (just the pie chart) ---\n","fig, ax_pie = plt.subplots(figsize=(6, 6), facecolor='white')\n","\n","# --- Pie Chart ---\n","wedges, _ = ax_pie.pie(\n","    sizes,\n","    startangle=90,\n","    colors=colors,\n","    explode=(0.03, 0.03),\n","    radius=1.0\n",")\n","\n","# --- External labels with leader lines ---\n","total = sum(sizes)\n","for i, w in enumerate(wedges):\n","    ang = (w.theta2 + w.theta1) / 2\n","    x = np.cos(np.deg2rad(ang))\n","    y = np.sin(np.deg2rad(ang))\n","\n","    # Line endpoints\n","    line_start = (x * 0.9, y * 0.9)\n","    line_end = (x * 1.2, y * 1.2)\n","\n","    # Draw leader line\n","    ax_pie.plot([line_start[0], line_end[0]], [line_start[1], line_end[1]],\n","                color='#801214', lw=1.8, alpha=0.9)\n","\n","    # Add label\n","    ha = 'left' if x >= 0 else 'right'\n","    ax_pie.text(\n","        line_end[0] + (0.05 if x >= 0 else -0.05),\n","        line_end[1],\n","        f\"{labels[i]}\\n({sizes[i]} images, {sizes[i]/total*100:.1f}%)\",\n","        ha=ha, va='center',\n","        fontsize=11, fontweight='bold', color='#4D0A0C'\n","    )\n","\n","# --- Title & styling ---\n","ax_pie.set_title(\n","    'Same vs Different Family (Heuristic)',\n","    fontsize=14, fontweight='bold', color='#801214', pad=20\n",")\n","ax_pie.set_facecolor('#F8F5F5')\n","ax_pie.set_aspect('equal')\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":539},"id":"pTQ4ALxwBwXv","executionInfo":{"status":"ok","timestamp":1762418857414,"user_tz":-330,"elapsed":6,"user":{"displayName":"Megh Patel","userId":"04599170497738914106"}},"outputId":"0062eb8c-6885-4e52-84a3-734f80a81d63"},"execution_count":23,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["different_family_pairs = []\n","\n","for i in misclassified_indices:\n","    true_label = all_labels[i]\n","    pred_label = all_preds[i]\n","\n","    fam_true = family_tokens.get(true_label, \"unknown\")\n","    fam_pred = family_tokens.get(pred_label, \"unknown\")\n","\n","    if fam_true != fam_pred:\n","        true_species = class_names[true_label]\n","        pred_species = class_names[pred_label]\n","        different_family_pairs.append((true_species, pred_species, fam_true, fam_pred))\n","\n","# Convert to DataFrame\n","diff_family_df = pd.DataFrame(\n","    different_family_pairs,\n","    columns=[\"True Species\", \"Predicted Species\", \